{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    /* tsc cannot expand a wildcard twice, so each component gets one line here.
       Vite resolves the same imports by pattern — see vite.config.ts. */
    "paths": {
      "@/components/ui/scroll-island": ["./components/scroll-island/scroll-island.tsx"],
      "@/components/ui/zero-melt-preloader": ["./components/zero-melt-preloader/zero-melt-preloader.tsx"],
      "@/components/ui/magic-hour": ["./components/magic-hour/magic-hour.tsx"],
      "@/components/ui/hover-expand-gallery": ["./components/hover-expand-gallery/hover-expand-gallery.tsx"],
      "@/components/ui/pinboard-portfolio-hero": ["./components/pinboard-portfolio-hero/pinboard-portfolio-hero.tsx"]
    }
  },
  "include": ["components", "dev", "vite.config.ts"]
}
